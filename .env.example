# ============================================================
# Configuration des variables d'environnement Nanobot
# ============================================================
# Copier ce fichier vers .env puis renseigner les valeurs réelles :
# Ne jamais committer le fichier .env ni une clé réelle.
#   cp .env.example .env
#
# Ce fichier est lu par start_local.py (développement local) et
# docker-compose.yml (déploiement Docker).
# start_local.py injecte automatiquement les variables *_API_KEY / *_API_BASE
# vers le Gateway avec le préfixe PLATFORM_.
# ============================================================


# ── Sécurité plateforme ──────────────────────────────────────
JWT_SECRET=change-me-in-development
# Clé Fernet dédiée au chiffrement des identifiants de canaux.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_ENCRYPTION_KEY=replace-with-a-dedicated-fernet-key

# ── Clés API des fournisseurs LLM ───────────────────────────
# Au moins une clé API est nécessaire pour appeler les modèles.
# Renseignez uniquement les fournisseurs réellement utilisés.

# Règle de nommage des modèles (valable pour DEFAULT_MODEL et la sélection
# de modèle dans le front-end) :
#   préfixe/nom-modèle — fournisseur explicite, ex. "dashscope/qwen-turbo"
#   nom-modèle seul    — association automatique par mot-clé,
#                        ex. "claude-sonnet-4-5" → Anthropic
#
# ┌─────────────┬───────────────────────────────────────────────┐
# │ Préfixe     │ Exemples                                      │
# ├─────────────┼───────────────────────────────────────────────┤
# │ claude/     │ claude/claude-sonnet-4-5                      │
# │ openai/     │ openai/gpt-5.2                                │
# │ deepseek/   │ deepseek/deepseek-chat, deepseek/deepseek-reasoner │
# │ dashscope/  │ dashscope/qwen3-coder-plus, dashscope/qwen-turbo │
# │ kimi/       │ kimi/kimi-k2.5, kimi/moonshot-v1-128k         │
# │ zhipu/      │ zhipu/glm-4-flash, zhipu/glm-4                │
# │ doubao/     │ doubao/doubao-pro-256k                        │
# │ aihubmix/   │ aihubmix/claude-sonnet-4-5                    │
# │ evolink/    │ evolink/gpt-5.2, evolink/deepseek-chat        │
# │ vllm/       │ vllm/Qwen2.5-7B-Instruct                      │
# │ (sans)      │ claude-sonnet-4-5 → Anthropic automatique     │
# │ (sans)      │ gpt-4o → OpenAI automatique                   │
# └─────────────┴───────────────────────────────────────────────┘
# Modèle MiniMax hébergé sur Alibaba Cloud :
# DEFAULT_MODEL=dashscope/MiniMax/MiniMax-M2.7


# Anthropic (série Claude)
# Association : nom de modèle contenant "claude" → routage automatique
# Exemples : claude-sonnet-4-5, claude/claude-opus-4-5
ANTHROPIC_API_KEY=

# OpenAI (séries GPT / o)
# Association : noms contenant "gpt", "o1", "o3", "o4" → routage automatique
# Exemples : gpt-4o, openai/gpt-4o-mini, openai/o3-mini
OPENAI_API_KEY=
# Si vous utilisez un endpoint non officiel OpenAI :
# OPENAI_API_BASE=xx

# DeepSeek
# Association : noms contenant "deepseek" → routage automatique
# Exemples : deepseek/deepseek-chat, deepseek/deepseek-reasoner
DEEPSEEK_API_KEY=

# Alibaba Cloud DashScope (série Qwen)
# Association : noms contenant "qwen" → routage automatique
# Exemples : dashscope/qwen3-coder-plus, dashscope/qwen-turbo, qwen-max
DASHSCOPE_API_KEY=

# Moonshot / Kimi
# Association : noms contenant "kimi" ou "moonshot" → routage automatique
# Exemples : kimi/kimi-k2.5, kimi/moonshot-v1-128k
# Remarque : kimi-k2.5 et similaires ne supportent pas le paramètre temperature ;
# le système ignore automatiquement ce paramètre.
KIMI_API_KEY=

# Zhipu AI (série GLM)
# Association : noms contenant "glm" → routage automatique
# Exemples : zhipu/glm-4-flash, zhipu/glm-4, glm-4-flash
ZHIPU_API_KEY=

# Doubao (ByteDance / Volcano Engine)
# Association : noms contenant "doubao" → routage automatique
# Exemples : doubao/doubao-pro-256k, doubao/doubao-lite-128k
# API Base : https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=

# AiHubMix (proxy agrégateur multi-modèles)
# Association : noms contenant "aihubmix" → routage automatique
# Exemples : aihubmix/claude-sonnet-4-5, aihubmix/gpt-4o
AIHUBMIX_API_KEY=

# Evolink (proxy agrégateur compatible OpenAI, multi-modèles)
# Association : noms contenant "evolink" → routage automatique
# Exemples : evolink/gpt-5.2, evolink/deepseek-chat
EVOLINK_API_KEY=

# OpenRouter (proxy agrégateur, solution de repli finale)
# Quand aucun fournisseur ci-dessus ne correspond, routage automatique via OpenRouter
# Exemple : openrouter/anthropic/claude-sonnet-4-5
OPENROUTER_API_KEY=


# ── Modèles auto-hébergés (vLLM) ────────────────────────────
# Si vous déployez un modèle local avec vLLM, configurez ces deux variables.
# La clé API peut être une chaîne quelconque non vide (vLLM ne la vérifie pas
# par défaut).
#
# Règles de routage :
#   1. préfixe "vllm/" explicite → vllm/Qwen2.5-7B-Instruct
#   2. si aucun fournisseur cloud ne correspond, repli automatique
#
# Exemple de lancement vLLM :
#   vllm serve /data/models/Qwen2.5-7B-Instruct \
#     --served-model-name Qwen2.5-7B-Instruct \
#     --enable-auto-tool-choice --tool-call-parser hermes \
#     --port 8000
HOSTED_VLLM_API_KEY=
HOSTED_VLLM_API_BASE=
# Exemple :
# HOSTED_VLLM_API_KEY=dummy
# HOSTED_VLLM_API_BASE=http://localhost:8000/v1


# ── Modèle par défaut ────────────────────────────────────────
# Modèle utilisé pour les nouveaux conteneurs utilisateurs.
# Format recommandé : "préfixe/nom-modèle".
# Exemples :
#   DEFAULT_MODEL=dashscope/qwen3-coder-plus    # Qwen Alibaba Cloud
#   DEFAULT_MODEL=claude-sonnet-4-5             # Anthropic Claude
#   DEFAULT_MODEL=kimi/kimi-k2.5                # Moonshot Kimi
#   DEFAULT_MODEL=vllm/Qwen2.5-7B-Instruct      # vLLM local
#   DEFAULT_MODEL=openai/gpt-5.2                # OpenAI
#   DEFAULT_MODEL=deepseek/deepseek-chat        # DeepSeek
DEFAULT_MODEL=dashscope/qwen3-coder-plus

# Capacités d'entrée du proxy plateforme (impacte la réception d'images)
# text       = modèles texte uniquement
# text,image = multimodaux (recommandé, reconnaissance d'images)
NANOBOT_PROXY__MODEL_INPUT=text,image

# Configuration MiniMax
MINIMAX_API_BASE=https://api.minimaxi.com/anthropic
MINIMAX_API_KEY=sk-xxx
DEFAULT_MODEL=minimax/MiniMax-M2.7
# Pour accélérer les réponses, la plateforme route par défaut MiniMax-M2.7
# vers la variante highspeed de la même famille.
# Pour utiliser strictement le modèle d'origine : false.
MINIMAX_M27_USE_HIGHSPEED=true

# ── Choix du backend runtime ────────────────────────────────
# Par défaut, seuls les conteneurs runtime basculent sur Hermes ; les chemins
# d'API externes restent /api/openclaw/* et /api/shared-openclaw/* (compatibilité).
# Pour revenir en arrière : openclaw.
PLATFORM_DEDICATED_RUNTIME_BACKEND=hermes
PLATFORM_SHARED_RUNTIME_BACKEND=hermes
PLATFORM_HERMES_CONNECT_RETRIES=60
PLATFORM_HERMES_RETRY_DELAY_SECONDS=0.5
# L'API Hermes n'expose par défaut que l'ensemble minimal d'outils requis
# (terminal pour les scripts, files pour lire/écrire les résultats,
# skills pour consulter les descriptions). none = questions seules ; full = tous les outils.
PLATFORM_HERMES_API_TOOLSETS=terminal,file,skills
# Raisoning/thinking du modèle désactivé par défaut pour réduire l'attente
# avant le premier token visible. minimal/low/medium/high/xhigh pour plus de
# raisonnement ; vide = valeur du fournisseur.
PLATFORM_HERMES_REASONING_EFFORT=none
# Palier d'accélération optionnel ; mappe vers service_tier=priority ou speed=fast
# selon le fournisseur. Laisser vide en cas de doute.
PLATFORM_HERMES_SERVICE_TIER=
PLATFORM_HERMES_IMAGE=nanobot-hermes-agent:latest
PLATFORM_OPENCLAW_IMAGE=openclaw:latest
PLATFORM_SHARED_HERMES_URL=http://shared-openclaw:8080
PLATFORM_SHARED_HERMES_API_KEY=dev-hermes-bridge-key

# ── OpenClaw-RL / collecte de trajectoires d'entraînement (PoC) ──
# Désactivé par défaut. Activé, le gateway écrit les traces model_chat
# anonymisées dans un JSONL local.
PLATFORM_TRAINING_TRACE_ENABLED=false
# Désactivé par défaut. Activé, expose l'endpoint interne POST /api/training/traces.
# En production : token long aléatoire obligatoire, appelé via
# Authorization: Bearer <token>.
PLATFORM_TRAINING_TRACE_INGEST_ENABLED=false
PLATFORM_TRAINING_TRACE_INGEST_TOKEN=
PLATFORM_TRAINING_TRACE_DIR=/app/.hermes/training_traces
PLATFORM_TRAINING_TRACE_HASH_SALT=

# ── Fuseau horaire des conteneurs ────────────────────────────
# Fuseau par défaut des conteneurs runtime utilisateur (hermes-user-*),
# impacte l'interprétation des expressions Cron.
CONTAINER_TZ=Asia/Shanghai

# ── Compte administrateur ────────────────────────────────────
# Compte admin créé automatiquement au premier démarrage
# (console de gestion http://host:3081). Ignoré si le nom existe déjà.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── Sécurité ─────────────────────────────────────────────────
# Clé de signature JWT pour l'émission/validation des tokens utilisateurs.
# IMPÉRATIF : changer en production par un secret fort aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production

# Marché de skills Git par défaut
NANOBOT_SKILLS_MARKETPLACE_REPO=https://github.com/johnson7788/collect_skills
