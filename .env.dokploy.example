# ============================================================
# MultiUserClaw — variables d'environnement pour Dokploy
# À coller dans Dokploy → Compose → Environment
# (format KEY=VALUE, une par ligne)
# ============================================================

# ── SÉCURITÉ (obligatoire) ────────────────────────────────────
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
# Clé Fernet dédiée aux tokens Telegram/Discord et données de liaison WhatsApp.
# Générer séparément : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_ENCRYPTION_KEY=replace-with-a-dedicated-fernet-key

# Compte admin créé au premier démarrage (console :3081)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── LLM : au moins UNE clé API (obligatoire) ─────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
AIHUBMIX_API_KEY=
EVOLINK_API_KEY=

# Modèle par défaut des nouveaux agents utilisateurs
DEFAULT_MODEL=dashscope/qwen3-coder-plus

# ── Ports hôtes (optionnel — adapter si conflit) ─────────────
FRONTEND_PORT=3080
MANAGE_PORT=3081
SIMPLE_PORT=3082
GATEWAY_PORT=8080

# ── Miroirs de build (laisser vide hors de Chine) ────────────
APT_DEBIAN_MIRROR=
APT_SECURITY_MIRROR=
PIP_INDEX_URL=https://pypi.org/simple

# ── Options runtime utilisateur ───────────────────────────────
CONTAINER_TZ=Europe/Paris
# RAM max par conteneur utilisateur (augmenter la RAM du VPS en conséquence)
PLATFORM_CONTAINER_MEMORY_LIMIT=2g
# Browser Playwright dans les images runtime (build long, +2 Go) : false conseillé
HERMES_INSTALL_BROWSER=false
